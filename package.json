{
  "name": "bf-cli-editor",
  "productName": "Betaflight CLI Editor",
  "version": "2.0.0",
  "description": "Betaflight 기체의 CLI 설정을 읽어 보고 편집하는 Windows 앱 (Betaflight 공식 프로그램 아님)",
  "main": "./out/main/index.js",
  "author": "클로에",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "fixtures:sample": "node scripts/make-sample-fixtures.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "@serialport/bindings-cpp": false,
    "electron-winstaller": false
  }
}
